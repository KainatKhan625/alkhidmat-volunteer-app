{
  "expo": {
    "name": "Alkhidmat Volunteer",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/alkhidmat-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alkhidmat.volunteerapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2E5395",
        "foregroundImage": "./assets/images/alkhidmat-logo.png",
        "monochromeImage": "./assets/images/alkhidmat-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/alkhidmat-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2E5395",
          "dark": {
            "backgroundColor": "#2E5395"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2aa59bf9-7e31-4bbb-b56f-c1aedfaae0b7"
      }
    }
  }
}